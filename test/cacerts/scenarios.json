  "with-apk-cert": {
    "image": "alpine:latest",
    "features": {
      "cacerts": {
        "urls": "https://letsencrypt.org/certs/isrgrootx1.pem"
      }
    }
  },
  "with-yum": {
    "image": "fedora:latest",
    "features": {
      "cacerts": {}
    }
  },
  "with-yum-cert": {
    "image": "fedora:latest",
    "features": {
      "cacerts": {
        "urls": "https://letsencrypt.org/certs/isrgrootx1.pem"
      }
    }
