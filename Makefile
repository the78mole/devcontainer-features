PROJECT_FOLDER ?= .

.PHONY: help \
        test test-scenarios test-basic \
        test-cacerts test-cacerts-scenarios test-cacerts-basic \
        test-jumpstarter-cli test-jumpstarter-cli-scenarios test-jumpstarter-cli-basic \
        test-nrf-tools test-nrf-tools-scenarios test-nrf-tools-basic \
        test-postgresql test-postgresql-scenarios test-postgresql-basic \
        test-pre-commit test-pre-commit-scenarios test-pre-commit-basic \
        test-uv test-uv-scenarios test-uv-basic \
        check lint \
        cleanup-runs cleanup-runs-auto cleanup-runs-failed cleanup-runs-failed-auto

# Default target
help: ## Diese Hilfe anzeigen
	@echo "Verfügbare Targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | \
		sort | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-40s\033[0m %s\n", $$1, $$2}'

# ── Alle Features ──────────────────────────────────────────────────────────────

test: ## Alle Feature-Tests ausführen (Basis + Scenarios)
	devcontainer features test -p $(PROJECT_FOLDER)

test-scenarios: ## Nur Scenario-Tests aller Features ausführen
	devcontainer features test -p $(PROJECT_FOLDER) --skip-autogenerated

test-basic: ## Nur Basis-Tests (test.sh) aller Features ausführen
	devcontainer features test -p $(PROJECT_FOLDER) --skip-scenarios

# ── Feature: cacerts ───────────────────────────────────────────────────────────

test-cacerts: ## Tests für Feature 'cacerts' ausführen
	devcontainer features test -p $(PROJECT_FOLDER) -f cacerts

test-cacerts-scenarios: ## Nur Scenario-Tests für Feature 'cacerts'
	devcontainer features test -p $(PROJECT_FOLDER) -f cacerts --skip-autogenerated

test-cacerts-basic: ## Nur Basis-Test (test.sh) für Feature 'cacerts'
	devcontainer features test -p $(PROJECT_FOLDER) -f cacerts --skip-scenarios

# ── Feature: jumpstarter-cli ───────────────────────────────────────────────────

test-jumpstarter-cli: ## Tests für Feature 'jumpstarter-cli' ausführen
