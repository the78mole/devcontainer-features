test-jumpstarter-cli-scenarios: ## Nur Scenario-Tests für Feature 'jumpstarter-cli'
	devcontainer features test -p $(PROJECT_FOLDER) -f jumpstarter-cli --skip-autogenerated

test-jumpstarter-cli-basic: ## Nur Basis-Test (test.sh) für Feature 'jumpstarter-cli'
	devcontainer features test -p $(PROJECT_FOLDER) -f jumpstarter-cli --skip-scenarios

# ── Feature: nrf-tools ────────────────────────────────────────────────────────

test-nrf-tools: ## Tests für Feature 'nrf-tools' ausführen (kein autogenerierter Test)
	devcontainer features test -p $(PROJECT_FOLDER) -f nrf-tools --skip-autogenerated

test-nrf-tools-scenarios: ## Nur Scenario-Tests für Feature 'nrf-tools'
	devcontainer features test -p $(PROJECT_FOLDER) -f nrf-tools --skip-autogenerated

test-nrf-tools-basic: ## Nur Basis-Test (test.sh) für Feature 'nrf-tools'
	devcontainer features test -p $(PROJECT_FOLDER) -f nrf-tools --skip-autogenerated --skip-scenarios

# ── Feature: postgresql ────────────────────────────────────────────────────────

test-postgresql: ## Tests für Feature 'postgresql' ausführen
