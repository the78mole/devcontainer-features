# ── Qualitätssicherung ─────────────────────────────────────────────────────────

check: ## README-Versionsreferenzen aller Features prüfen
	bash scripts/check-feature-readme-versions.sh

lint: check ## Alias für check

# ── GitHub Actions Wartung ─────────────────────────────────────────────────────

cleanup-runs: ## Alte GitHub Actions Runs löschen (behält die 20 neuesten)
	bash scripts/cleanup-runs.sh

cleanup-runs-auto: ## Alte Runs löschen ohne Bestätigungsabfrage (behält 20)
	bash scripts/cleanup-runs.sh -y

cleanup-runs-failed: ## Alle fehlgeschlagenen Runs löschen (mit Bestätigung)
	bash scripts/cleanup-runs.sh --failed

cleanup-runs-failed-auto: ## Alle fehlgeschlagenen Runs ohne Rückfrage löschen
	bash scripts/cleanup-runs.sh -y --failed
